# SAP 网关基址（不含 ACTION；各工具自行带 ACTION）
# PRD: http://192.168.1.164:8020/zbak_inf
# DEV demo: http://192.168.1.162:8010/zbak_mcp_demo
SAP_BASE_URL=http://192.168.1.164:8020/zbak_inf

SAP_USERNAME=
SAP_PASSWORD=
SAP_TIMEOUT_MS=30000

# profit | demo | all（缺省 profit，保持现有生产实例行为）
MCP_TOOLSET=profit
MCP_SERVER_NAME=mcp-sap-bak

MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_PATH=/mcp
MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=your.public.host

# 用户自助登录（经 Nginx 反代时填写对外根地址）
# MCP_PUBLIC_URL=http://192.168.1.177/mcp-sap-bak-dev
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
# MCP_LOGIN_TTL_DAYS=30
# 需要按小时时写这个（优先于 DAYS），例如 1 小时：
# MCP_LOGIN_TTL_HOURS=1
