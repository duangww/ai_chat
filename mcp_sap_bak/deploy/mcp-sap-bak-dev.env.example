# 复制到 /etc/mcp/mcp-sap-bak-dev.env
# 按实际 DEV 主机/端口改 SAP_BASE_URL；Token 必须与 PRD 不同
SAP_BASE_URL=http://192.168.1.160:8000/zbak_mcp_demo
SAP_USERNAME=CHANGE_ME
SAP_PASSWORD=CHANGE_ME
SAP_TIMEOUT_MS=30000

MCP_TOOLSET=demo
MCP_SERVER_NAME=mcp-sap-bak-dev

MCP_HOST=127.0.0.1
MCP_PORT=3101
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.177
MCP_AUTH_TOKEN=CHANGE_ME_DEV_TOKEN

MCP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MCP_ACCOUNTS_KEY=CHANGE_ME_ACCOUNTS_KEY
MCP_ACCOUNTS_FILE=/etc/mcp/mcp-sap-bak-dev-accounts.json

# 对外访问根地址（Nginx 反代后的前缀，不要末尾斜杠）
MCP_PUBLIC_URL=http://192.168.1.177/mcp-sap-bak-dev
# 内网 HTTP 必须开，否则 OAuth issuer 校验会拒绝
MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
# 用户自助登录 Token 有效期（天）。要 1 小时则改成 MCP_LOGIN_TTL_HOURS=1（优先于 DAYS）
MCP_LOGIN_TTL_DAYS=30
