{
  "name": "mcp-sap-bak",
  "version": "1.0.0",
  "description": "bak 组织 SAP MCP：同一份代码按 MCP_TOOLSET 对接 PRD zbak_inf 或 DEV zbak_mcp_demo",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sap-bak": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "sap",
    "bak",
    "zbak_inf"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
